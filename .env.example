# ==============================================================================
# NYERAS LinkedIn Company-Post Feed (built into the Next.js site; token + posts in MySQL)
# Copy to .env and fill in. Never commit .env. On Vercel, add these in Project Settings
# -> Environment Variables. See LINKEDIN_INTEGRATION.md.
# ==============================================================================

# 1. LinkedIn developer app credentials (server only - never exposed to the browser)
# App must have the Community Management API product approved.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# 2. NYERAS organization: numeric ID or full URN ("12345678" or "urn:li:organization:12345678")
LINKEDIN_ORG_ID=""

# 3. Optional OAuth redirect URI. By default it is <site origin>/api/linkedin/callback
# (e.g. http://localhost:3001/api/linkedin/callback, https://www.nyeras.com/api/linkedin/callback).
# Whatever is used must exactly match an Authorized Redirect URL in the LinkedIn app's Auth tab.
# LINKEDIN_REDIRECT_URI=""

# 4. API version (Linkedin-Version header, YYYYMM). Each version is supported ~12 months.
# 202609 is supported until Sept 2027 - bump before it is sunset.
LINKEDIN_API_VERSION="202609"
# r_organization_social reads the organization's posts. Image previews additionally need
# w_organization_social (LinkedIn's Images API requires a write-level scope for GET).
LINKEDIN_SCOPES="r_organization_social"

# 5. How old the cached feed may get before a page view refreshes it (ms, default 300000 = 5 min, minimum 30000)
LINKEDIN_SYNC_INTERVAL_MS="300000"

# 6. Optional key for scripted use of GET /api/linkedin/auth and POST /api/linkedin/sync
# (X-LinkedIn-Admin-Key header or ?key=). Signed-in /lms admins never need it.
# Generate with: openssl rand -hex 32
LINKEDIN_ADMIN_KEY=""

# 7. Optional: token from LinkedIn's developer token generator instead of the Connect flow
LINKEDIN_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# Admin portal (/lms) — all optional; defaults are ADMIN@2026 / admin@nyeras2026
# ---------------------------------------------------------------------------
# ADMIN_USERNAME="ADMIN@2026"
# ADMIN_PASSWORD="admin@nyeras2026"
# Secret used to sign the admin session cookie (set a long random string in production)
# ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Google Sheets Integration (Request Callback Leads)
# Sheet URL: https://docs.google.com/spreadsheets/d/1j29qQWzQchQA1pFu66A7WbSs8LnvHVn1Yr4aCzXyMaE/edit?gid=0#gid=0
# ---------------------------------------------------------------------------
GOOGLE_SPREADSHEET_ID="1j29qQWzQchQA1pFu66A7WbSs8LnvHVn1Yr4aCzXyMaE"
# Google Apps Script Web App Webhook URL (Recommended - zero Google Cloud setup)
GOOGLE_SHEETS_WEBHOOK_URL=""
# Optional: Direct Google Sheets API via service account credentials
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# MySQL Database Configuration
# ---------------------------------------------------------------------------
# Defaults fallback to the Nyeras production MySQL database if omitted.
# Overriding via environment variables is recommended for staging/dev environments.
MYSQL_HOST="217.21.95.130"
MYSQL_USER="u477423730_nyeras_d_u"
MYSQL_PASSWORD=""
MYSQL_DATABASE="u477423730_mx_nyeras_d"

# ---------------------------------------------------------------------------
# SMTP / Email Notification Configuration (Nodemailer)
# Used for consultation requests, hiring forms, offline enquiries, and support tickets.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@nyeras.com"
SMTP_PASS=""
NOTIFICATION_EMAIL="thenyera@gmail.com"

# ---------------------------------------------------------------------------
# Site URL Configuration
# Used by certificate verification and SEO metadata.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.nyeras.com"

