# ==============================================================================
# NYERAS LinkedIn Company-Post Feed (Express backend: `npm run server`)
# Copy to .env and fill in. Never commit .env. See LINKEDIN_INTEGRATION.md.
# ==============================================================================

# 1. LinkedIn developer app credentials (backend only - never exposed to the browser)
# App must have the Community Management API product approved.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# 2. NYERAS organization: numeric ID or full URN ("12345678" or "urn:li:organization:12345678")
LINKEDIN_ORG_ID=""

# 3. OAuth redirect URI - must exactly match an Authorized Redirect URL in the LinkedIn app.
# It points at the Express backend, not the Next.js site.
LINKEDIN_REDIRECT_URI="http://localhost:5001/api/linkedin/callback"

# 4. API version (Linkedin-Version header, YYYYMM). Each version is supported ~12 months.
# 202609 is supported until Sept 2027 - bump before it is sunset.
LINKEDIN_API_VERSION="202609"
# r_organization_social reads the organization's posts. Image previews additionally need
# w_organization_social (LinkedIn's Images API requires a write-level scope for GET).
LINKEDIN_SCOPES="r_organization_social"

# 5. Scheduled synchronization (ms, default 300000 = 5 min, minimum 30000)
LINKEDIN_SYNC_INTERVAL_MS="300000"
# Optional cron expression; overrides the interval when valid
# LINKEDIN_SYNC_CRON="*/5 * * * *"

# 6. Admin key protecting GET /api/linkedin/auth and POST /api/linkedin/sync.
# If empty, those endpoints only accept requests from localhost. Required in production.
# Generate with: openssl rand -hex 32
LINKEDIN_ADMIN_KEY=""

# 7. Optional: token from LinkedIn's developer token generator instead of the OAuth flow
LINKEDIN_ACCESS_TOKEN=""

# 8. Optional: where tokens/posts are cached (default ./.cache, git-ignored)
# LINKEDIN_CACHE_DIR=""

# 9. Backend server & browser connectivity
PORT="5001"
# Origin of the Next.js site; used for CORS, Socket.IO and the OAuth popup postMessage
FRONTEND_URL="http://localhost:3000"
# Extra comma-separated origins allowed for CORS/Socket.IO (e.g. www + apex domain)
# CORS_ALLOWED_ORIGINS="https://www.nyeras.com"

# 10. Next.js side
# Server-only: where Next.js proxies /api/linkedin/posts and /api/linkedin/status
LINKEDIN_BACKEND_URL="http://localhost:5001"
# Public: Socket.IO endpoint for live feed updates (the Express backend)
NEXT_PUBLIC_SOCKET_URL="http://localhost:5001"

# ---------------------------------------------------------------------------
# Admin portal (/lms) — all optional; defaults are ADMIN@2026 / admin@nyeras2026
# ---------------------------------------------------------------------------
# ADMIN_USERNAME="ADMIN@2026"
# ADMIN_PASSWORD="admin@nyeras2026"
# Secret used to sign the admin session cookie (set a long random string in production)
# ADMIN_SESSION_SECRET=""